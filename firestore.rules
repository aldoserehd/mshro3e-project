rules_version = '2';

// Mshro3e Firestore security rules.
// Free customer browse: anyone can read public catalog.
// Only signed-in users can write their own user doc.
// Owner-side writes will use the Admin SDK from the Next.js admin app.

service cloud.firestore {
  match /databases/{database}/documents {

    // Public catalog — anyone can read. Writes are OWNER-SCOPED:
    // a signed-in vendor can only create/update docs they own. The owner
    // admin writes via the Admin SDK (bypasses rules entirely).
    match /categories/{id} {
      allow read: if true;
      allow write: if false; // owner admin only (Admin SDK)
    }
    match /vendors/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        // vendors cannot touch moderation/subscription fields
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['ownerUid', 'status', 'tier', 'subscriptionUntil',
                      'verifiedAt', 'rating', 'reviewCount', 'createdAt']);
      allow delete: if false;
    }
    match /products/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId))
             .data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId))
             .data.ownerUid == request.auth.uid;
    }
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.customerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // User profile — read/write only your own doc
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Leads — WhatsApp contact events (vendor attribution).
    // Anyone may CREATE a lead (customers browse without an account).
    // Any signed-in user may READ (the vendor portal filters by their own
    // vendorId client-side). NOTE: tighten later so a vendor can only read
    // leads where the lead's vendor is owned by them (needs a rules `get()`
    // join or denormalising ownerUid onto each lead).
    // UPDATE is limited to the Lead-Inbox status fields (mark replied/sold +
    // sale amount) — the original attribution fields stay immutable.
    match /leads/{id} {
      allow create: if true;
      // A customer reads their own leads; a vendor reads leads for a vendor
      // doc they own.
      allow read: if request.auth != null
        && (resource.data.customerUid == request.auth.uid
          || get(/databases/$(database)/documents/vendors/$(resource.data.vendorId))
               .data.ownerUid == request.auth.uid);
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId))
             .data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'saleAmount', 'statusUpdatedAt']);
      allow delete: if false;
    }

    // Vendors can suggest new categories; only the owner admin reads/acts.
    match /categorySuggestions/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Seed marker — only signed-in users can read/write
    match /_meta/{id} {
      allow read, write: if request.auth != null;
    }

    // Subscriptions (vendor side, future) — placeholder strict
    match /subscriptions/{id} {
      allow read, write: if false;
    }
  }
}

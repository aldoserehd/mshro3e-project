rules_version = '2';

// Mshro3e Firestore security rules.
// Free customer browse: anyone can read public catalog.
// Only signed-in users can write their own user doc.
// Owner-side writes will use the Admin SDK from the Next.js admin app.

service cloud.firestore {
  match /databases/{database}/documents {

    // Public catalog — anyone can read. Writes are OWNER-SCOPED:
    // a signed-in vendor can only create/update docs they own. The owner
    // admin writes via the Admin SDK (bypasses rules entirely).
    match /categories/{id} {
      allow read: if true;
      allow write: if false; // owner admin only (Admin SDK)
    }
    match /vendors/{id} {
      allow read: if true;
      // Self-serve storefronts start life awaiting moderation — only the
      // owner admin (Admin SDK) can flip status to 'active'.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.tier == null
        && request.resource.data.verifiedAt == null;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        // vendors cannot touch moderation/subscription fields
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['ownerUid', 'status', 'tier', 'subscriptionUntil',
                      'verifiedAt', 'rating', 'reviewCount', 'createdAt']);
      allow delete: if false;
    }
    match /products/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId))
             .data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId))
             .data.ownerUid == request.auth.uid;
    }
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    // User profile — read/write/delete only your own doc.
    // Delete supports in-app account deletion (App Store requirement).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Leads — WhatsApp contact events (vendor attribution).
    // Anyone may CREATE a lead (customers browse without an account).
    // Any signed-in user may READ (the vendor portal filters by their own
    // vendorId client-side). NOTE: tighten later so a vendor can only read
    // leads where the lead's vendor is owned by them (needs a rules `get()`
    // join or denormalising ownerUid onto each lead).
    // UPDATE is limited to the Lead-Inbox status fields (mark replied/sold +
    // sale amount) — the original attribution fields stay immutable.
    match /leads/{id} {
      allow create: if true;
      // A customer reads their own leads; a vendor reads leads for a vendor
      // doc they own.
      allow read: if request.auth != null
        && (resource.data.customerUid == request.auth.uid
          || get(/databases/$(database)/documents/vendors/$(resource.data.vendorId))
               .data.ownerUid == request.auth.uid);
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId))
             .data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'saleAmount', 'statusUpdatedAt'])
        // vendorId can't be repointed at a vendor you own to hijack a lead
        && request.resource.data.vendorId == resource.data.vendorId
        && request.resource.data.status in ['new', 'replied', 'sold']
        && (!('saleAmount' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.saleAmount is number);
      allow delete: if false;
    }

    // Vendors can suggest new categories; only the owner admin reads/acts.
    // Create-only, shape-validated so the doc can't be used as scratch storage.
    match /categorySuggestions/{id} {
      allow create: if request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200;
      allow read, update, delete: if false;
    }

    // AI quota counters — written ONLY by the server (Admin SDK, which bypasses
    // rules). No client may read or write: clients could otherwise reset their
    // own monthly count and bypass tier billing.
    match /aiUsage/{id} {
      allow read, write: if false;
    }

    // Seed marker — only signed-in users can read/write
    match /_meta/{id} {
      allow read, write: if request.auth != null;
    }

    // Subscriptions (vendor side, future) — placeholder strict
    match /subscriptions/{id} {
      allow read, write: if false;
    }
  }
}

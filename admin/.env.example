# ─────────────────────────────────────────────────────────────────────────
# admin/.env.local template. Copy to admin/.env.local and fill in.
# NEVER commit the filled-in .env.local. Values here are PLACEHOLDERS only.
# ─────────────────────────────────────────────────────────────────────────

# Firebase Web SDK (client-side, safe to expose — shipped in the browser bundle)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-side ONLY — NEVER prefix with NEXT_PUBLIC_).
# Paste the full service-account key JSON as a SINGLE LINE (no newlines).
# Generate: Firebase Console → Project Settings → Service accounts → Generate key.
FIREBASE_ADMIN_SERVICE_ACCOUNT=

# Owner allow-list — comma-separated Firebase UIDs that get owner privileges.
# Leave empty in dev to treat any 'owner'-role session as owner.
OWNER_UIDS=

# Anthropic / Claude — powers the paid AI routes (api/ai/describe, api/ai/storefront).
# Without this key those routes return HTTP 503 (ai_not_configured) and no AI runs.
ANTHROPIC_API_KEY=

# Claude model id for the AI routes. Optional — defaults to claude-opus-4-8.
AI_MODEL=claude-opus-4-8
